CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_ALL_NONSHARED=n
CONFIG_IB=n
CONFIG_IB_STANDALONE=n

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-06=y

CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y

# Proxy: Nikki + Honk
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_luci-app-honk=y

# App Filter & Time Control
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-timecontrol=y

# Traffic Monitor (Bandix only)
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-wrtbwmon=n
CONFIG_PACKAGE_wrtbwmon=n
CONFIG_PACKAGE_luci-app-vnstat=n
CONFIG_PACKAGE_luci-app-vnstat2=n
CONFIG_PACKAGE_luci-app-netdata=n
CONFIG_PACKAGE_netdata=n
CONFIG_PACKAGE_luci-app-statistics=n

# IPTV
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_igmpproxy=y

# Tools & Services
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_gately=y
CONFIG_PACKAGE_luci-app-gately=y
CONFIG_PACKAGE_luci-app-ap-modem=y
CONFIG_PACKAGE_fastnet=y
CONFIG_PACKAGE_luci-app-fastnet=y
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-fwlive=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# WireGuard
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# LED Control
CONFIG_PACKAGE_luci-app-gpioled=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-network=y
